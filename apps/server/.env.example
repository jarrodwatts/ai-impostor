# --- realtime server env (Railway) ---
PORT=8080
# Comma-separated allowed WS/CORS origins. `*` (or empty) allows any — fine for the demo.
WS_ALLOWED_ORIGINS=http://localhost:3000

# data stores (Railway-internal URLs in prod). Optional — server defaults to in-memory.
DATABASE_URL=postgres://user:pass@localhost:5432/ai_impostor
REDIS_URL=redis://localhost:6379

# AI agents — optional. Set for real Claude; unset → deterministic FakeLlmClient.
ANTHROPIC_API_KEY=sk-ant-...

# --- Monad testnet + on-chain demo ---
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Deployed ImpostorEscrow (chain 10143). Demo uses the live deploy below.
ESCROW_ADDRESS=0x25c4966C497F5E633a110314Dc284942C284ebc1
# Demo wallet (admin + GAME_MANAGER + serverSigner + treasury + faucet source).
# Drives createGame/lockGame/settle txs AND EIP712-signs settlements AND funds the
# faucet. NEVER commit a real key. When this + ESCROW_ADDRESS are set the server
# runs the LIVE on-chain demo flow; otherwise it uses the in-memory FakeChainService.
GAME_MANAGER_PRIVATE_KEY=0x...

# --- demo lobby / economics (optional; sensible defaults shown) ---
MIN_HUMANS=2                          # humans required to start a countdown
SEATS=10                              # total seats (humans + AI)
BUY_IN_WEI=10000000000000000          # 0.01 MON human buy-in (AI never fund)
FAUCET_DRIP_WEI=100000000000000000    # 0.1 MON per faucet request
FAUCET_COOLDOWN_MS=21600000           # one faucet drip per address per 6h
DEPOSIT_CONFIRM_RETRIES=8             # escrow deposit poll attempts (block inclusion)
DEPOSIT_CONFIRM_DELAY_MS=400          # delay between deposit polls (ms)
